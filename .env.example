# ---------------------------------------------------------------------------
# Contact form delivery
#
# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — never commit real credentials.
#
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste that 16-character
# value into SMTP_PASS. Your normal account password will not work.
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=bedune.freefire@gmail.com
SMTP_PASS=

# Where messages land. Defaults to the address in content/profile.ts.
CONTACT_TO=bedune.freefire@gmail.com
